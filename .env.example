APP_PORT=8080
SERVER_PORT=8080
SQLSERVER_PORT=1433
MSSQL_PID=Express
MSSQL_DATABASE=controle_pedidos
MSSQL_SA_PASSWORD=TroqueEstaSenha123!
SPRING_DATASOURCE_URL=jdbc:sqlserver://sqlserver:1433;databaseName=controle_pedidos;sendStringParametersAsUnicode=false;encrypt=true;trustServerCertificate=true;
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=TroqueEstaSenha123!
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
TZ=America/Sao_Paulo

# Origens permitidas para chamadas ao backend (separadas por vírgula).
# Se o frontend acessar via proxy /api (mesma origem), normalmente não
# precisa incluir o IP do frontend aqui. Inclua apenas se algo acessar
# o backend diretamente (ex.: Swagger, Postman, app mobile).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Chave usada para assinar os tokens JWT. TROCAR por um valor aleatório
# e forte em produção (ex.: openssl rand -base64 32).
JWT_SECRET_KEY=53cr37
# Tempo de expiração do access token em milissegundos (padrão: 1h)
JWT_EXPIRATION=3600000
